# SafeNSound backend (see backend/README.md). Defaults to http://localhost:8787.
NEXT_PUBLIC_API_URL=http://localhost:8787
# Must match the backend's DASHBOARD_TOKEN. Leave blank when that is unset (local dev).
# Demo shortcut: this value is visible in the browser bundle.
NEXT_PUBLIC_DASHBOARD_TOKEN=

# Optional. Leave blank to use the built-in sample requests (still decided by the backend).
# With an agent ID, the ElevenLabs agent calls the backend's /tools/* server tools itself.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
