{
  "name": "@safespend/backend",
  "version": "0.1.0",
  "private": true,
  "description": "SafeSpend backend: policy engine, ElevenLabs tool endpoints, guardian API, QuickNode webhook, scam scorer",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "tunnel": "cloudflared tunnel --no-autoupdate --url http://localhost:8787",
    "elevenlabs:setup": "tsx scripts/elevenlabs-setup.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@fastify/cors": "^11.4.3",
    "@solana/web3.js": "^1.99.0",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
