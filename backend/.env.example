# Copy to .env. Empty values are treated as unset.

PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# Where guardian alerts link to, and which origins may call the API.
DASHBOARD_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Shared secret ElevenLabs sends as the `x-safespend-tool-secret` header on server tool calls.
TOOL_SECRET=
# Bearer token for the dashboard API (`Authorization: Bearer ...` or `?token=` for SSE). Unset = open (local dev only).
DASHBOARD_TOKEN=
# Token QuickNode Streams sends (`x-safespend-webhook-token` header or `?token=` on the destination URL).
WEBHOOK_TOKEN=

# Optional Telegram alert channel. Without these, alerts go to the log only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SOLANA_CLUSTER=devnet
ALERT_TIMEZONE=America/Chicago

# Demo-only routes (/api/demo/*): force-pay bypassing the policy engine, top-ups.
DEMO_ROUTES=true
# Hold approval window for the seeded demo vault, in seconds.
DEMO_HOLD_SECONDS=1800
SCHEDULER_INTERVAL_MS=5000

# Scam scorer layer 2: Claude reads call transcripts and what the senior says about a payment.
# Without a key, only the keyword rules run.
ANTHROPIC_API_KEY=
SCAM_LLM=true
SCAM_LLM_MODEL=claude-opus-5-5
# A payment request waits this long for Claude before deciding on keyword rules alone.
SCAM_LLM_PAYMENT_TIMEOUT_MS=8000
SCAM_LLM_CALL_TIMEOUT_MS=20000
