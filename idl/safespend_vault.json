          },
          {
            "name": "guardians",
            "docs": [
              "1..=3. A vetted professional fills a slot when there is no family."
            ],
            "type": {
              "vec": "pubkey"
            }
          },
          {
            "name": "professional_mask",
            "docs": [
              "Bitmap over `guardians` marking vetted professionals."
            ],
            "type": "u8"
          },
          {
            "name": "big_amount_threshold",
            "docs": [
              "At or above this, a hold needs 2 approvals (if there are at least 2 guardians)."
            ],
            "type": "u64"
          },
          {
            "name": "per_payment_limit",
            "type": "u64"
          },
          {
            "name": "weekly_cap",
            "type": "u64"
          },
          {
            "name": "window_start",
            "type": "i64"
          },
          {
            "name": "spent_in_window",
            "type": "u64"
          },
          {
            "name": "hold_seconds",
            "docs": [
              "Approval deadline length for holds."
            ],
            "type": "i64"
          },
          {
            "name": "unfreeze_delay_seconds",
            "docs": [
              "Senior self-unfreeze delay (~48h)."
            ],
            "type": "i64"
          },
          {
            "name": "change_delay_seconds",
            "docs": [
              "Waiting period before a new payee becomes usable."
            ],
