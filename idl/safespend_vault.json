    {
      "name": "Vault",
      "docs": [
        "One per senior, PDA `[\"vault\", senior]`. Owns the USDC associated token account that holds the",
        "spendable balance; held funds sit in per-hold escrows, so this balance is always spendable."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "senior",
            "type": "pubkey"
          },
          {
            "name": "mint",
